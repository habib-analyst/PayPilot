# PayPilot config — copy to .env and fill in. Never commit a real .env.

# --- Real PayPal sandbox (default mode) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BRAND_NAME=PayPilot Demo Store
PAYPAL_RETURN_URL=https://example.com/return
PAYPAL_CANCEL_URL=https://example.com/cancel

# --- LLM (free Google AI Studio key; the default endpoint below is
# Google's OpenAI-compatible endpoint, so the key works as-is) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3-flash-preview

# --- Mocked checkout (use when PayPal sandbox signup is unavailable,
# e.g. Pakistan). 1 = simulate PayPal locally: MOCK- order ids, a local
# mock-approval page, and a MOCK label on every order row plus a
# MOCKED CHECKOUT badge. No PayPal credentials needed in this mode.
# Never present a mock run as a live PayPal run. ---
PAYPILOT_MOCK_PAYPAL=0

# --- Optional: force the deterministic scripted demo dialogue instead of
# the real LLM. Without an LLM_API_KEY the scripted dialogue is used
# automatically; with a key, the real LLM stays the default. ---
PAYPILOT_SCRIPTED_LLM=0

# --- Base URL used for mock approval links (default http://localhost:8000) ---
PAYPILOT_PUBLIC_URL=http://localhost:8000
